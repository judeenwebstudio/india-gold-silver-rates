# Copy this file to .env and replace the placeholders with your own local
# PostgreSQL credentials. Never commit the completed .env file.
# Runtime application connection. On Vercel + Supabase, use the transaction
# pooler URL (port 6543). Local PostgreSQL can keep the direct connection.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:6543/postgres?pgbouncer=true"
# Optional migration connection. Use the Supabase direct or session-pooler URL.
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/india_gold_rates?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Auth.js v5 infers the request URL on Vercel. Do not add AUTH_URL or
# NEXTAUTH_URL unless a valid absolute HTTP(S) override is genuinely required.
ADMIN_EMAIL="admin@indiagoldrates.local"
ADMIN_PASSWORD="replace-with-a-strong-password-of-at-least-12-characters"
RATE_PRIMARY_PROVIDER="GOODRETURNS"
RATE_SECONDARY_PROVIDER="IBJA"
RATE_TERTIARY_PROVIDER="BANKBAZAAR"
RATE_CITY="Tiruchirappalli"
RATE_TIMEZONE="Asia/Kolkata"
RATE_STALE_HOURS="30"
RATE_MAX_VARIANCE_PERCENT="20"
BANKBAZAAR_ENABLED="false"
BANKBAZAAR_AUTHORISED="false"
MCX_ENABLED="false"
# Existing IBJA fallback configuration.
RATE_SOURCE_NAME="IBJA"
RATE_SOURCE_URL="https://www.ibjarates.com/"
RATE_SOURCE_ENABLED="true"
SCRAPER_MAX_CHANGE_PERCENT="20"
SCRAPER_USER_AGENT="IndiaGoldSilverRates/1.0 (+http://localhost:3000/admin/api-logs)"
SCRAPER_REQUEST_TIMEOUT_MS="15000"
SCRAPER_MAX_RETRIES="2"
CRON_SECRET="replace-with-a-long-random-secret"
VERCEL_CRON_ENABLED="false"
RATE_SYNC_TIMEZONE="Asia/Kolkata"
CITY_ADJUSTMENT_MAX_ABS="5000"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""

# Payment secrets are server-only. Never prefix these with NEXT_PUBLIC.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Existing PhonePe variables remain supported.
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX=""
PHONEPE_ENV="PRODUCTION"
PHONEPE_MERCHANT_STATUS="BLOCKED_MERCHANT"

# Transactional email (server-only)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="RateStack"
SMTP_FROM_EMAIL=""

# Shiprocket fulfilment (server-only)
SHIPROCKET_ENABLED="false"
SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_WEBHOOK_SECRET=""
SHIPROCKET_DEFAULT_LENGTH_CM=""
SHIPROCKET_DEFAULT_BREADTH_CM=""
SHIPROCKET_DEFAULT_HEIGHT_CM=""
SHIPROCKET_DEFAULT_WEIGHT_KG=""
SHIPROCKET_DEFAULT_MODE="Surface"
