generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  role         AdminRole @default(ORDER_MANAGER)
  orderNotes   AdminOrderNote[]
  orderHistory OrderStatusHistory[]
  trackingEvents ShipmentTrackingEvent[]
  paymentVerifications PaymentVerification[]
  refunds      ShopRefund[]
  adminAuditLogs AdminAuditLog[]

  @@index([isActive, email])
}

enum AdminRole {
  SUPER_ADMIN
  ORDER_MANAGER
  FINANCE
  FULFILLMENT
  SUPPORT
  VIEWER
}

enum ShopOrderStatus {
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAYMENT_VERIFIED
  ORDER_CONFIRMED
  PROCESSING
  PACKED
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCEL_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum ShopShipmentStatus {
  NOT_CREATED
  READY_TO_SHIP
  PICKUP_SCHEDULED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum TrackingEventSource {
  ADMIN
  PAYMENT_GATEWAY
  SHIPROCKET
  SYSTEM
}

enum PaymentVerificationResult {
  VERIFIED
  FAILED
  MANUAL_REVIEW
}

enum ShopRefundStatus {
  NOT_REQUIRED
  PENDING
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  FAILED
}

enum ShiprocketIntegrationStatus {
  DISABLED
  NOT_CONFIGURED
  READY
  ORDER_CREATED
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RTO
  FAILED
  MANUAL
}

enum LogisticsOperationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LogisticsWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
}

enum MetalType {
  GOLD
  SILVER
}

enum MetalPurity {
  K24  @map("24K")
  K22  @map("22K")
  K18  @map("18K")
  K14  @map("14K")
  P999 @map("999")
  P925 @map("925")
}

enum AuthProvider {
  GOOGLE
  PASSWORD
  MOBILE
}

enum RateUpdateStatus {
  SUCCESS
  FAILED
  REJECTED
  NO_CHANGE
}

enum RateSyncExecutionType {
  MANUAL_TEST
  MANUAL_SYNC
  AUTOMATIC_CRON
}

enum RateHistoryAction {
  CREATE
  UPDATE
  SOFT_DELETE
}

enum RateProvider {
  GOODRETURNS
  IBJA
  BANKBAZAAR
  MCX
  PREVIOUS_VERIFIED_RATE
  OTHER
}

enum RateSourceType {
  SOURCE_PUBLISHED_CITY_RATE
  MARKET_REFERENCE_RATE
  EXCHANGE_BENCHMARK
  INDICATIVE_CALCULATED_RATE
  PREVIOUS_VERIFIED_RATE
}

enum RateSourceUnit {
  PER_GRAM
  PER_10_GRAMS
  PER_KILOGRAM
}

enum RateValidationStatus {
  VALID
  REJECTED
  FALLBACK
}

enum AnalyticsEventType {
  PAGE_VIEW
  CITY_VIEW
}

model State {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
}

model City {
  id                  String      @id @default(cuid())
  name                String
  slug                String      @unique
  stateId             String
  gold24KAdjustment   Decimal     @default(0) @db.Decimal(12, 4)
  gold22KAdjustment   Decimal     @default(0) @db.Decimal(12, 4)
  gold18KAdjustment   Decimal     @default(0) @db.Decimal(12, 4)
  gold14KAdjustment   Decimal     @default(0) @db.Decimal(12, 4)
  silver999Adjustment Decimal     @default(0) @db.Decimal(12, 4)
  isActive            Boolean     @default(true)
  deletedAt           DateTime?
  state               State       @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  metalRates          MetalRate[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([stateId, name])
  @@index([stateId, isActive])
  @@index([isActive, name])
  @@index([isActive, deletedAt])
}

model MetalRate {
  id               String        @id @default(cuid())
  metalType        MetalType
  purity           MetalPurity
  pricePerGram     Decimal       @db.Decimal(14, 4)
  pricePerKilogram Decimal?      @db.Decimal(16, 2)
  cityId           String?
  city             City?         @relation(fields: [cityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  source           String
  provider         RateProvider?
  sourceType       RateSourceType?
  sourceValue      Decimal?      @db.Decimal(18, 4)
  sourceUnit       RateSourceUnit?
  normalizedPer10Grams Decimal?  @db.Decimal(18, 4)
  normalizedPerKg  Decimal?      @db.Decimal(18, 4)
  conversionApplied Boolean      @default(false)
  conversionFormula String?
  rateDate         DateTime?
  sourcePublishedAt DateTime?
  fetchedAt        DateTime?
  lastSuccessfulSync DateTime?
  validationStatus RateValidationStatus?
  validationMessage String?
  sourceReference  String?
  rawResponseHash  String?
  fallbackUsed     Boolean       @default(false)
  fallbackReason   String?
  originalProvider RateProvider?
  originalRateDate DateTime?
  recordedAt       DateTime
  isActive         Boolean       @default(true)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  rateHistory      RateHistory[]

  @@index([metalType, purity, recordedAt])
  @@index([metalType, isActive, recordedAt])
  @@index([cityId, recordedAt])
  @@index([source, recordedAt])
  @@index([isActive, recordedAt])
  @@index([recordedAt])
}

model RateHistory {
  id           String            @id @default(cuid())
  metalRateId  String
  metalType    MetalType
  action       RateHistoryAction
  previousData Json?
  newData      Json?
  source       String            @default("ADMIN_UI")
  createdAt    DateTime          @default(now())
  metalRate    MetalRate         @relation(fields: [metalRateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([metalRateId, createdAt])
  @@index([metalType, action, createdAt])
  @@index([createdAt])
}

model RateUpdateLog {
  id               String                @id @default(cuid())
  source           String
  sourceUrl        String?
  status           RateUpdateStatus
  executionType    RateSyncExecutionType @default(MANUAL_SYNC)
  message          String
  changedRates     Int                   @default(0)
  attemptCount     Int                   @default(1)
  durationMs       Int?
  sourceRecordedAt DateTime?
  rawData          Json?
  createdAt        DateTime              @default(now())

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([sourceUrl, createdAt])
  @@index([executionType, createdAt])
  @@index([executionType, status, createdAt])
}

model RateSyncLock {
  key         String   @id
  ownerToken  String
  acquiredAt  DateTime
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AnalyticsVisitor {
  id          String             @id @default(cuid())
  visitorKey  String             @unique
  firstSeenAt DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  sessions    AnalyticsSession[]
  events      AnalyticsEvent[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

model AnalyticsSession {
  id          String           @id @default(cuid())
  sessionKey  String           @unique
  visitorId   String
  visitor     AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  startedAt   DateTime         @default(now())
  lastSeenAt  DateTime         @default(now())
  isReturning Boolean          @default(false)
  events      AnalyticsEvent[]

  @@index([visitorId, startedAt])
  @@index([startedAt])
  @@index([isReturning, startedAt])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  eventKey   String             @unique
  eventType  AnalyticsEventType @default(PAGE_VIEW)
  visitorId  String
  visitor    AnalyticsVisitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessionId  String
  session    AnalyticsSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  path       String
  pageTitle  String?
  citySlug   String?
  cityName   String?
  stateSlug  String?
  stateName  String?
  recordedAt DateTime           @default(now())
  createdAt  DateTime           @default(now())

  @@index([eventType, recordedAt])
  @@index([visitorId, recordedAt])
  @@index([sessionId, recordedAt])
  @@index([path, eventType, recordedAt])
  @@index([citySlug, recordedAt])
}

// ==========================================
// GOLD & SILVER SAVINGS SCHEME MODULE
// ==========================================

enum SchemeStatus {
  ACTIVE
  PAUSED
  MATURED
  REDEMPTION_REQUESTED
  QUOTED
  REDEEMED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PaymentOrderStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum LedgerEntryType {
  INSTALLMENT_CREDIT
  MANUAL_ENTRY_CREDIT
  PROMOTIONAL_BONUS_CREDIT
  REVERSAL_DEBIT
  REDEMPTION_DEBIT
  REFUND_DEBIT
}

enum RedemptionStatus {
  REQUESTED
  QUOTED
  USER_ACCEPTED
  PAYMENT_PENDING
  APPROVED
  COIN_ALLOCATED
  READY_FOR_COLLECTION
  DISPATCHED
  DELIVERED
  COMPLETED
  REJECTED
  EXPIRED
}

enum KycStatus {
  DISABLED
  PENDING
  APPROVED
  REJECTED
}

enum ManualPaymentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

model MerchantConfig {
  id                 String    @id @default("default")
  legalSellerName    String
  gstin              String
  invoiceIssuer      String
  coinSupplier       String
  fulfilmentEntity   String
  refundLiableEntity String
  ownerApproved      Boolean   @default(false)
  caApproved         Boolean   @default(false)
  legalApproved      Boolean   @default(false)
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SchemeUser {
  id                 String              @id @default(cuid())
  fullName           String
  phone              String?             @unique
  email              String?             @unique
  mobileVerifiedAt   DateTime?
  emailVerifiedAt    DateTime?
  preferredLoginMethod String            @default("MOBILE")
  accountStatus      String              @default("ACTIVE")
  lastLoginAt        DateTime?
  passwordHash       String?
  profileImageUrl    String?
  pinHash            String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  isActive           Boolean             @default(true)
  kycRecordId        String?             @unique
  kycRecord          KycRecord?          @relation(fields: [kycRecordId], references: [id])
  enrollments        SchemeEnrollment[]
  paymentOrders      PaymentOrder[]
  redemptionRequests RedemptionRequest[]
  auditLogs          AuditLog[]
  shopOrders         ShopOrder[]
  deliveryAddresses DeliveryAddress[]
  authAccounts       AuthAccount[]
  gstProfiles        CustomerGSTProfile[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([phone, isActive])
  @@index([email, isActive])
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  user              SchemeUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
  @@index([providerEmail])
}

model ShopProduct {
  id                        String      @id @default(cuid())
  slug                      String      @unique
  name                      String
  metalType                 MetalType
  purity                    MetalPurity
  description               String
  imageUrl                  String?
  imageData                 Bytes?
  imageMimeType             String?
  availableWeightsGramsJson Json
  serviceChargeBasisPoints  Int         @default(500)
  gstBasisPoints            Int         @default(300)
  isActive                  Boolean     @default(true)
  orders                    ShopOrder[]
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  @@index([isActive, metalType])
}

model ShopOrder {
  id                         String    @id @default(cuid())
  orderNumber                String    @unique
  userId                     String
  user                       SchemeUser @relation(fields: [userId], references: [id])
  productId                  String
  product                    ShopProduct @relation(fields: [productId], references: [id])
  productName                String
  metalType                  MetalType
  purity                     MetalPurity
  weightGrams                Decimal   @db.Decimal(12, 3)
  quantity                   Int
  trichyRatePerGramPaise     BigInt
  metalValuePaise            BigInt
  serviceChargeBasisPoints   Int
  serviceChargePaise         BigInt
  gstBasisPoints             Int
  gstPaise                   BigInt
  shippingAmountPaise        BigInt    @default(0)
  totalAmountPaise           BigInt
  currency                   String    @default("INR")
  customerName               String?
  customerPhone              String?
  customerEmail              String?
  addressLine1               String?
  addressLine2               String?
  landmark                   String?
  deliveryCity               String?
  deliveryDistrict           String?
  deliveryState              String?
  deliveryPincode            String?
  deliveryCountry            String?   @default("India")
  addressType                String?
  rateSource                 String?
  rateDate                   DateTime?
  idempotencyKey             String?   @unique
  gateway                    String
  gatewayOrderId             String?
  gatewayPaymentId           String?
  gatewaySignature           String?
  paymentStatus              String    @default("CREATED")
  orderStatus                ShopOrderStatus @default(PAYMENT_PENDING)
  invoiceNumber              String?   @unique
  failureCode                String?
  failureMessage             String?
  paidAt                     DateTime?
  courierPartner             String?
  trackingNumber             String?
  shipmentStatus             ShopShipmentStatus @default(NOT_CREATED)
  expectedDeliveryAt         DateTime?
  pickupAt                   DateTime?
  deliveredAt                DateTime?
  publicTrackingUrl          String?
  shipmentId                 String?
  discountAmountPaise        BigInt @default(0)
  cancellationReason         String?
  cancellationPaymentCaptured Boolean?
  cancellationRefundRequired Boolean?
  cancellationShipmentCreated Boolean?
  gstInvoiceRequested          Boolean   @default(false)
  gstBusinessName              String?
  gstNumber                    String?
  gstBillingAddress            String?
  shipmentTimelineJson       Json?
  shiprocketOrderId          String?
  shiprocketShipmentId       String?
  shiprocketChannelOrderId   String?
  shiprocketStatusCode       Int?
  shiprocketStatusText       String?
  courierId                  String?
  courierName                String?
  awbCode                    String?   @unique
  pickupTokenNumber          String?
  pickupScheduledAt          DateTime?
  pickupExpectedAt           DateTime?
  shipmentCreatedAt          DateTime?
  labelUrl                   String?
  manifestUrl                String?
  shiprocketInvoiceUrl       String?
  estimatedDeliveryAt        DateTime?
  shiprocketLastSyncedAt     DateTime?
  shiprocketLastWebhookAt    DateTime?
  shiprocketRawStatus        String?
  shiprocketIntegrationStatus ShiprocketIntegrationStatus @default(DISABLED)
  shiprocketFailureReason    String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  statusHistory              OrderStatusHistory[]
  trackingEvents             ShipmentTrackingEvent[]
  adminNotes                 AdminOrderNote[]
  paymentVerification        PaymentVerification?
  refunds                    ShopRefund[]
  shiprocketOperations       ShiprocketOperation[]
  logisticsWebhookEvents     LogisticsWebhookEvent[]
  notificationOutbox         NotificationOutbox[]

  @@index([userId, createdAt])
  @@index([gatewayOrderId])
  @@index([paymentStatus, orderStatus])
  @@index([trackingNumber])
  @@index([shipmentStatus])
  @@index([shiprocketShipmentId])
  @@index([shiprocketIntegrationStatus, shiprocketLastSyncedAt])
  @@index([gstNumber])
}

model CustomerGSTProfile {
  id             String     @id @default(cuid())
  customerId     String
  customer       SchemeUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessName   String
  gstNumber      String
  billingAddress String
  isDefault      Boolean    @default(true)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([customerId, gstNumber])
  @@index([customerId, isActive, isDefault])
}

model ShiprocketOperation {
  id                 String                     @id @default(cuid())
  shopOrderId        String
  shopOrder          ShopOrder                  @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  operationType      String
  idempotencyKey     String                     @unique
  requestFingerprint String
  status             LogisticsOperationStatus   @default(PENDING)
  responseReference  String?
  errorCode          String?
  errorMessage       String?
  attemptedAt        DateTime                   @default(now())
  completedAt        DateTime?
  retryCount         Int                        @default(0)

  @@index([shopOrderId, operationType])
  @@index([status, attemptedAt])
}

model LogisticsWebhookEvent {
  id               String                   @id @default(cuid())
  provider         String
  eventIdentifier  String?
  awb              String?
  shipmentId       String?
  statusText       String?
  eventOccurredAt  DateTime?
  payloadHash      String                   @unique
  payloadJson      Json
  receivedAt       DateTime                 @default(now())
  processedAt      DateTime?
  processingStatus LogisticsWebhookStatus   @default(RECEIVED)
  failureReason    String?
  shopOrderId      String?
  shopOrder        ShopOrder?               @relation(fields: [shopOrderId], references: [id], onDelete: SetNull)

  @@unique([provider, eventIdentifier])
  @@index([processingStatus, receivedAt])
  @@index([awb])
  @@index([shipmentId])
}

model NotificationOutbox {
  id          String                   @id @default(cuid())
  shopOrderId String
  shopOrder   ShopOrder                @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  body        String
  payloadJson Json?
  status      NotificationOutboxStatus @default(PENDING)
  createdAt   DateTime                 @default(now())
  sentAt      DateTime?
  lastError   String?

  @@index([status, createdAt])
  @@index([shopOrderId, createdAt])
}

model OrderStatusHistory {
  id            String              @id @default(cuid())
  orderId       String
  order         ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        ShopOrderStatus
  publicMessage String
  internalNote  String?
  source        TrackingEventSource
  adminUserId   String?
  adminUser     AdminUser?          @relation(fields: [adminUserId], references: [id])
  createdAt     DateTime            @default(now())

  @@index([orderId, createdAt])
}

model ShipmentTrackingEvent {
  id            String              @id @default(cuid())
  orderId       String
  order         ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        String
  publicMessage String
  internalNote  String?
  source        TrackingEventSource
  adminUserId   String?
  adminUser     AdminUser?          @relation(fields: [adminUserId], references: [id])
  createdAt     DateTime            @default(now())

  @@index([orderId, createdAt])
}

model AdminOrderNote {
  id          String    @id @default(cuid())
  orderId     String
  order       ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  body        String
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([orderId, createdAt])
}

model PaymentVerification {
  id                  String                    @id @default(cuid())
  orderId             String                    @unique
  order               ShopOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway             String
  gatewayOrderId      String?
  gatewayPaymentId    String?
  verifiedAmountPaise BigInt?
  signatureValid      Boolean?
  result              PaymentVerificationResult
  resultMessage       String
  responseJson        Json?
  adminUserId         String?
  adminUser           AdminUser?                @relation(fields: [adminUserId], references: [id])
  verifiedAt          DateTime                  @default(now())
}

model ShopRefund {
  id                 String           @id @default(cuid())
  orderId            String
  order              ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountPaise        BigInt
  gatewayRefundId    String?
  status             ShopRefundStatus @default(PENDING)
  reason             String
  initiatedAt        DateTime         @default(now())
  completedAt        DateTime?
  failureReason      String?
  adminUserId        String
  adminUser          AdminUser        @relation(fields: [adminUserId], references: [id])

  @@index([orderId, initiatedAt])
}

model AdminAuditLog {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id])
  action       String
  targetEntity String
  targetId     String
  detailsJson  Json?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([targetEntity, targetId, createdAt])
  @@index([adminUserId, createdAt])
}

model DeliveryAddress {
  id           String     @id @default(cuid())
  userId       String
  user         SchemeUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  mobile       String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  district     String
  state        String
  pincode      String
  country      String     @default("India")
  addressType  String     @default("HOME")
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, isDefault])
}

model EmailAuthToken {
  id                String    @id @default(cuid())
  userId            String
  email             String
  purpose           String
  tokenHash         String    @unique
  expiresAt         DateTime
  resendAvailableAt DateTime
  resendCount       Int       @default(0)
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, purpose, createdAt])
  @@index([email, purpose, createdAt])
}

model KycRecord {
  id                   String      @id @default(cuid())
  panMasked            String?
  aadhaarMasked        String?
  alternativeIdType    String?
  alternativeIdMasked String?
  status               KycStatus   @default(PENDING)
  documentUrlEncrypted String?
  verifiedAt           DateTime?
  schemeUser           SchemeUser?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model SchemePlan {
  id                    String                    @id @default(cuid())
  name                  String
  metalType             MetalType
  purity                MetalPurity
  tenureMonths          Int
  minMonthlyAmountPaise BigInt
  maxMonthlyAmountPaise BigInt
  presetAmountsJson     Json
  gracePeriodDays       Int                       @default(7)
  termsVersion          String
  termsContent          String
  kycRequired           Boolean                   @default(false)
  visibility            Boolean                   @default(true)
  isActive              Boolean                   @default(true)
  version               Int                       @default(1)
  versions              SchemePlanVersion[]
  enrollments           SchemeEnrollment[]
  coinDenominations     CoinProductDenomination[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([isActive, visibility])
  @@index([metalType, purity])
}

model SchemePlanVersion {
  id           String     @id @default(cuid())
  planId       String
  version      Int
  snapshotJson Json
  createdAt    DateTime   @default(now())
  plan         SchemePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
}

model CoinProductDenomination {
  id                String     @id @default(cuid())
  planId            String
  plan              SchemePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  metalType         MetalType
  purity            MetalPurity
  weightMilligrams  BigInt
  title             String
  mintingFeePaise   BigInt     @default(0)
  packagingFeePaise BigInt     @default(0)
  inStock           Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([planId, inStock])
  @@index([metalType, weightMilligrams])
}

model Nominee {
  id           String           @id @default(cuid())
  enrollmentId String           @unique
  fullName     String
  relationship String
  phone        String?
  age          Int?
  enrollment   SchemeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model SchemeEnrollment {
  id                            String                @id @default(cuid())
  accountNumber                 String                @unique
  userId                        String
  user                          SchemeUser            @relation(fields: [userId], references: [id])
  planId                        String
  plan                          SchemePlan            @relation(fields: [planId], references: [id])
  metalType                     MetalType
  purity                        MetalPurity
  tenureMonths                  Int
  monthlyAmountPaise            BigInt
  totalScheduledAmountPaise     BigInt
  eligiblePurchaseBalancePaise  BigInt                @default(0)
  paidInstallmentCount          Int                   @default(0)
  remainingInstallmentCount     Int
  startDate                     DateTime
  maturityDate                  DateTime
  nextDueDate                   DateTime?
  overdueAmountPaise            BigInt                @default(0)
  status                        SchemeStatus          @default(ACTIVE)
  termsVersion                  String
  acceptedTermsAt               DateTime              @default(now())
  nominee                       Nominee?
  installments                  InstallmentSchedule[]
  paymentOrders                 PaymentOrder[]
  ledgerEntries                 SchemeLedgerEntry[]
  receipts                      Receipt[]
  redemptionRequests            RedemptionRequest[]
  manualPaymentQueue            ManualPaymentQueue[]
  refundRequests                RefundRequest[]
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  @@index([userId, status])
  @@index([accountNumber])
  @@index([status, maturityDate])
  @@index([nextDueDate, status])
}

model InstallmentSchedule {
  id             String           @id @default(cuid())
  enrollmentId   String
  enrollment     SchemeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  installmentNo  Int
  dueDate        DateTime
  amountPaise    BigInt
  status         InstallmentStatus @default(PENDING)
  paidAt         DateTime?
  paymentOrderId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([enrollmentId, installmentNo])
  @@index([enrollmentId, status])
  @@index([dueDate, status])
}

model PaymentOrder {
  id               String             @id @default(cuid())
  orderId          String             @unique
  enrollmentId     String
  enrollment       SchemeEnrollment   @relation(fields: [enrollmentId], references: [id])
  userId           String
  user             SchemeUser         @relation(fields: [userId], references: [id])
  amountPaise      BigInt
  currency         String             @default("INR")
  gateway          String
  status           PaymentOrderStatus @default(CREATED)
  idempotencyKey   String             @unique
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  receipts         Receipt[]
  ledgerEntries    SchemeLedgerEntry[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([enrollmentId, status])
  @@index([userId, createdAt])
  @@index([gatewayOrderId])
}

model SchemeLedgerEntry {
  id                 String           @id @default(cuid())
  enrollmentId       String
  enrollment         SchemeEnrollment @relation(fields: [enrollmentId], references: [id])
  type               LedgerEntryType
  amountPaise        BigInt
  balanceAfterPaise  BigInt
  referenceType      String
  referenceId        String
  paymentOrderId     String?
  paymentOrder       PaymentOrder?    @relation(fields: [paymentOrderId], references: [id])
  actorType          String
  actorId            String?
  metadata           Json?
  createdAt          DateTime         @default(now())

  @@index([enrollmentId, createdAt])
  @@index([referenceType, referenceId])
}

model Receipt {
  id             String           @id @default(cuid())
  receiptNumber  String           @unique
  paymentOrderId String
  paymentOrder   PaymentOrder     @relation(fields: [paymentOrderId], references: [id])
  enrollmentId   String
  enrollment     SchemeEnrollment @relation(fields: [enrollmentId], references: [id])
  userId         String
  amountPaise    BigInt
  paymentDate    DateTime
  pdfPath        String?
  createdAt      DateTime         @default(now())

  @@index([enrollmentId, createdAt])
  @@index([receiptNumber])
}

model ManualPaymentQueue {
  id               String              @id @default(cuid())
  enrollmentId     String
  enrollment       SchemeEnrollment    @relation(fields: [enrollmentId], references: [id])
  installmentNo    Int?
  amountPaise      BigInt
  paymentMode      String
  referenceNumber  String?
  makerAdminId     String
  checkerAdminId   String?
  status           ManualPaymentStatus @default(PENDING_APPROVAL)
  proofDocumentUrl String?
  rejectionReason  String?
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([enrollmentId, status])
}

model RedemptionQuotation {
  id                           String            @id @default(cuid())
  quotationNumber              String            @unique
  redemptionRequestId          String            @unique
  redemptionRequest            RedemptionRequest @relation(fields: [redemptionRequestId], references: [id], onDelete: Cascade)
  rateSource                   String
  rateTimestamp                DateTime
  validUntil                   DateTime
  ratePerGramPaise             BigInt
  selectedWeightMilligrams     BigInt
  metalValuePaise              BigInt
  mintingChargesPaise          BigInt
  packagingChargesPaise        BigInt
  gstBasisPoints               Int               @default(300)
  gstAmountPaise               BigInt
  deliveryChargesPaise         BigInt
  totalGrossValuePaise         BigInt
  eligibleBalanceAppliedPaise BigInt
  netDifferencePayablePaise    BigInt
  userAccepted                 Boolean           @default(false)
  userAcceptedAt               DateTime?
  createdAt                    DateTime          @default(now())
}

model RedemptionRequest {
  id                  String               @id @default(cuid())
  enrollmentId        String
  enrollment          SchemeEnrollment     @relation(fields: [enrollmentId], references: [id])
  userId              String
  user                SchemeUser           @relation(fields: [userId], references: [id])
  status              RedemptionStatus     @default(REQUESTED)
  collectionMethod    String
  deliveryAddressJson Json?
  quotation           RedemptionQuotation?
  redemptionOrder     RedemptionOrder?
  reviewedByAdminId   String?
  adminNotes          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([enrollmentId, status])
  @@index([status, createdAt])
}

model RedemptionOrder {
  id                        String            @id @default(cuid())
  invoiceNumber             String            @unique
  redemptionRequestId       String            @unique
  redemptionRequest         RedemptionRequest @relation(fields: [redemptionRequestId], references: [id])
  finalPricePerGramPaise    BigInt
  actualWeightMilligrams    BigInt
  finalGstPaise             BigInt
  finalMakingChargesPaise   BigInt
  finalDeliveryChargesPaise BigInt
  finalDifferencePaidPaise  BigInt
  paymentStatus             String
  fulfillmentStatus         String
  coinSerialNumber          String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([invoiceNumber])
  @@index([fulfillmentStatus, createdAt])
}

model RefundRequest {
  id                   String           @id @default(cuid())
  enrollmentId         String
  enrollment           SchemeEnrollment @relation(fields: [enrollmentId], references: [id])
  requestedAmountPaise BigInt
  approvedAmountPaise  BigInt?
  gatewayRefundId      String?
  status               RefundStatus     @default(PENDING)
  reasoning            String
  approvedByAdminId    String?
  processedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([enrollmentId, status])
}

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String?
  enrollmentId String?
  channel      String
  eventType    String
  title        String
  body         String
  metadata     Json?
  sentAt       DateTime @default(now())

  @@index([userId, sentAt])
  @@index([enrollmentId, sentAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  actorType    String
  actorId      String?
  action       String
  targetEntity String
  targetId     String?
  detailsJson  Json?
  ipAddress    String?
  user         SchemeUser? @relation(fields: [actorId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([actorType, actorId])
  @@index([action, createdAt])
  @@index([targetEntity, targetId])
}

model PasswordResetOtp {
  id                  String    @id @default(cuid())
  mobileNumber        String
  otpHash             String
  resetTokenHash      String?   @unique
  expiresAt           DateTime
  resetTokenExpiresAt DateTime?
  resendAvailableAt   DateTime
  attemptCount        Int       @default(0)
  verifiedAt          DateTime?
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([mobileNumber, createdAt])
  @@index([resetTokenHash])
}
